<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to Secrets.config (same folder, git-ignored) and set JwtSecret.
  Web.config merges these keys into its appSettings.

  JwtSecret signs login tokens: anyone who knows it can sign in as any user. Use at least
  32 random characters and keep it out of source control. In Windows PowerShell:

    $b = New-Object byte[] 48; [Security.Cryptography.RNGCryptoServiceProvider]::Create().GetBytes($b); [Convert]::ToBase64String($b)

  The API refuses to start while the value is shorter than 32 bytes, so this placeholder
  cannot be used by accident.
-->
<appSettings>
  <add key="JwtSecret" value="" />
</appSettings>
