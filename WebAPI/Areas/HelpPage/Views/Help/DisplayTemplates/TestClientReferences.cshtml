@using System.Text.RegularExpressions
<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
<link href="~/Areas/HelpPage/TestClient.css" rel="stylesheet" />
@* Automatically grabs the installed version of JQuery/JQueryUI/KnockoutJS *@
@* Sorted because GetFiles has no guaranteed order and jQuery must load before jQuery UI:
   ordinal order puts jquery-x.y.z ahead of jquery-ui-x.y.z, then knockout-x.y.z. *@
@{var filePattern = @"(jquery-[0-9]+.[0-9]+.[0-9]+.js|jquery-ui-[0-9]+.[0-9]+.[0-9]+.js|knockout-[0-9]+.[0-9]+.[0-9]+.js)";}
@foreach (var item in Directory.GetFiles(Server.MapPath(@"~/Scripts")).Where(f => Regex.IsMatch(f, filePattern)).OrderBy(f => Path.GetFileName(f), StringComparer.OrdinalIgnoreCase))
{
    <script src="~/Scripts/@Path.GetFileName(item)"></script>
}
<script src="~/Scripts/WebApiTestClient.js" defer="defer"></script>